# Copy to .env and fill in your values.
INTERVUO_JWT_SECRET=replace-with-a-secure-random-string

INTERVUO_GEMINI_API_KEY=your-google-gemini-api-key
INTERVUO_GEMINI_MODEL=gemini-2.5-flash

INTERVUO_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intervuo

INTERVUO_DEBUG=false
INTERVUO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INTERVUO_NUM_QUESTIONS=8
INTERVUO_MAX_PDF_SIZE_MB=5
